# =============================================================================
# Frontend (nginx) configuration.
#
#   cp frontend/.env.example frontend/.env
#
# These values are NOT compiled into the bundle. docker-entrypoint.sh renders
# them into /usr/share/nginx/html/runtime-config.js at container start, and the
# browser reads window.__APP_CONFIG__. That is what lets one image be promoted
# from dev to prod unchanged instead of building an image per environment.
#
# Nothing secret belongs here — every value is served to every visitor.
# =============================================================================

# Where the browser sends API calls.
#
# For local Docker Compose this must be the host-visible middleware URL, because
# the request is made by the browser on your machine, not by the frontend
# container. `http://middleware:8080` would only resolve inside the compose
# network and will fail with a connection error in the browser.
#
# On Kubernetes leave this EMPTY: the Ingress serves the UI and /api from the
# same host, so requests are same-origin and no CORS preflight is involved.
API_BASE_URL=http://localhost:8080

# Shown on the login screen and used to hide the seed-account shortcuts when
# it is `prod`.
APP_ENV=dev
