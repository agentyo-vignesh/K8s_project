{
  "name": "ai-interview-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "React UI for the AI Interview Platform",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 3000",
