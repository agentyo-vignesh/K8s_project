# ---------- Secrets / local environment ----------
# Configuration is one file per service. The .env.example files ARE committed;
# the real .env files never are.
.env
.env.local
database/.env
middleware/.env
backend/.env
frontend/.env
!**/.env.example
*.pem
*.key
!**/testdata/*.key

# Helm values holding real credentials. secrets.yaml.example IS committed.
helm/secrets.yaml
!helm/secrets.yaml.example

# ---------- Java / Maven ----------
target/
!.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.properties.local
*.class
hs_err_pid*

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ---------- Node / frontend ----------
node_modules/
dist/
.vite/
npm-debug.log*
pnpm-debug.log*
# Anchored, not a bare coverage/ - an unanchored directory pattern matches at
# every depth, and git does not descend into an excluded directory, so a source
# folder that happened to share the name would vanish with no way to negate it.
frontend/coverage/

# ---------- SonarQube ----------
# Scanner working directory, written next to sonar-project.properties.
.scannerwork/

# ---------- Terraform ----------
.terraform/
*.tfstate
*.tfstate.*

# A saved plan is not a summary - it is the full proposed state, including every
# value marked sensitive. `terraform show tfplan` prints the generated database
# password in clear. Treat it exactly like a state file.
tfplan
*.tfplan

# tfvars are excluded by default because they are where people put passwords.
# terraform/env/ is the exception and must be committed: those files ARE the
# definition of each environment, they hold no secrets - the database password is
# generated by random_password and read from Secrets Manager - and an environment
# that lives only on one laptop is not an environment.
*.tfvars
!terraform/env/*.tfvars
!*.tfvars.example

# .terraform.lock.hcl is deliberately NOT ignored. It pins the exact provider
# versions, so everyone and every CI run resolves the same ones. Ignoring it is a
# common habit and it means a provider release can change a plan with no commit.

# ---------- Runtime data ----------
# Leading slash matters. Written as "storage/" this also matched
# middleware/src/main/java/.../service/storage/ and silently dropped five source
# files from the repository - the build only failed once CI compiled a fresh
# clone. A negation cannot rescue that: git does not descend into an excluded
# directory, so anchoring is the fix.
/data/
/uploads/
/storage/
/logs/
*.log

# ---------- IDE / OS ----------
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
