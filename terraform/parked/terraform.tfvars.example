# =============================================================================
# Copy to terraform.tfvars (git-ignored) and adjust.
#
# There is no password or API key here, by design. The database password, JWT
# signing key and internal API key are generated by Terraform and written
# directly to Secrets Manager; making them variables would put them in a file on
# someone's laptop.
# =============================================================================

project_name = "ai-interview"
environment  = "dev"
aws_region   = "ap-south-1"
owner        = "platform-engineering"
cost_centre  = "engineering"

# ----------------------------------------------------------------- networking
vpc_cidr                = "10.20.0.0/16"
availability_zone_count = 2

# One NAT gateway saves ~USD 32/month per AZ avoided and is a single point of
# failure. Fine for dev; set false for prod.
single_nat_gateway = true

# ----------------------------------------------------------------- eks
kubernetes_version      = "1.31"
node_instance_types     = ["t3.large"]
node_group_min_size     = 2
node_group_max_size     = 6
node_group_desired_size = 2
node_disk_size          = 50

# Narrow this to your office or VPN range. The default in variables.tf is
# 0.0.0.0/0 so a training cluster works without a bastion; that is not a
# production posture.
# cluster_endpoint_public_access_cidrs = ["203.0.113.0/24"]

# ----------------------------------------------------------------- rds
db_name                  = "ai_interview"
db_username              = "ai_interview_app"
db_instance_class        = "db.t4g.micro"
db_allocated_storage     = 20
db_max_allocated_storage = 100
db_engine_version        = "16.14"
db_multi_az              = false
db_backup_retention_days = 7
db_deletion_protection   = false

# ----------------------------------------------------------------- application
# Must match the namespace you deploy the Helm release into: the IRSA trust
# policies are scoped to `system:serviceaccount:<this>:<name>`, so a mismatch
# means the pods cannot assume their roles and will fail their startup probes.
kubernetes_namespace = "ai-interview-dev"

ecr_image_retention_count = 20

# ----------------------------------------------------------------- github oidc
github_repository = "your-org/ai-interview-platform"

# An AWS account can hold only one OIDC provider per URL. Set false if another
# stack already created token.actions.githubusercontent.com in this account.
create_github_oidc_provider = true

# =============================================================================
# Production overrides
# =============================================================================
# environment                          = "prod"
# single_nat_gateway                   = false
# availability_zone_count              = 3
# node_instance_types                  = ["m6i.xlarge"]
# node_group_min_size                  = 3
# node_group_desired_size              = 3
# node_group_max_size                  = 12
# db_instance_class                    = "db.m6g.large"
# db_multi_az                          = true
# db_backup_retention_days             = 30
# db_deletion_protection               = true
# kubernetes_namespace                 = "ai-interview-prod"
# cluster_endpoint_public_access_cidrs = ["<your office CIDR>"]
