# # =============================================================================
# # Secrets Manager
# #
# # Two secrets, matching what the application expects:
# #
# #   <prefix>/database     RDS-rotation JSON shape, read by both services
# #   <prefix>/application  jwtSigningKey and aiServiceApiKey
# #
# # The database secret's field names deliberately match what RDS-managed rotation
# # writes, so switching to managed rotation later needs no application change.
# # =============================================================================

# resource "aws_secretsmanager_secret" "database" {
#   name        = "${var.project_name}/${var.environment}/database"
#   description = "PostgreSQL connection details for the AI Interview Platform"

#   # Zero in non-prod so a `terraform destroy` followed by an apply does not
#   # collide with a secret still in the 30-day recovery window.
#   recovery_window_in_days = var.environment == "prod" ? 30 : 0

#   tags = local.common_tags
# }

