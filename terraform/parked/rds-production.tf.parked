# # =============================================================================
# # PostgreSQL on RDS, plus the Secrets Manager secrets the application reads.
# #
# # The master password is generated here and written straight to Secrets Manager.
# # It is never a Terraform variable, never in a tfvars file, and never printed by
# # an output. It does land in Terraform state, which is why the S3 backend is
# # encrypted and access-controlled.
# # =============================================================================

# resource "random_password" "db" {
#   length  = 32
#   special = true
#   # RDS rejects these in a master password, and `/` and `@` would also need
#   # escaping in a connection URL.
#   override_special = "!#$%&*()-_=+[]{}<>:?"
# }

# resource "random_password" "jwt_signing_key" {
#   # 64 bytes, comfortably above the 32-byte minimum HS256 requires. Alphanumeric
#   # only so it survives any transport (env var, JSON, YAML) without escaping.
#   length  = 64
#   special = false
# }

# resource "random_password" "ai_service_api_key" {
#   length  = 48
#   special = false
# }

