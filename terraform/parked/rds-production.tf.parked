# # -----------------------------------------------------------------------------
# # Parameter group.
# #
# # Explicit rather than default so logging behaviour is deliberate and versioned.
# # -----------------------------------------------------------------------------
# resource "aws_db_parameter_group" "main" {
#   name_prefix = "${local.name_prefix}-pg16-"
#   family      = "postgres16"
#   description = "AI Interview Platform PostgreSQL 16 parameters"

#   # Log any statement slower than a second: enough to find the query behind a
#   # latency alert, quiet enough not to fill the log with healthy traffic.
#   parameter {
#     name  = "log_min_duration_statement"
#     value = "1000"
#   }

#   parameter {
#     name  = "log_connections"
#     value = "1"
#   }

#   parameter {
#     name  = "log_disconnections"
#     value = "1"
#   }

#   # A session that holds a transaction open indefinitely blocks vacuum and can
#   # exhaust connections; kill it after five minutes.
#   parameter {
#     name  = "idle_in_transaction_session_timeout"
#     value = "300000"
#   }

#   # Enables pg_stat_statements, which is the difference between "the database is
#   # slow" and "this query is slow".
#   parameter {
#     name         = "shared_preload_libraries"
#     value        = "pg_stat_statements"
#     apply_method = "pending-reboot"
#   }

#   tags = local.common_tags

#   lifecycle {
#     create_before_destroy = true
