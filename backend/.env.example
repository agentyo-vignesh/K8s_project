# =============================================================================
# AI service (FastAPI) configuration.
#
#   cp backend/.env.example backend/.env
#
# On EKS these same variable names come from a ConfigMap and from AWS Secrets
# Manager via IRSA, so the image is identical in every environment.
# =============================================================================

# ----------------------------------------------------------------- runtime
APP_ENV=dev
SERVER_PORT=8000
LOG_LEVEL=DEBUG
API_PREFIX=/api/v1

# ----------------------------------------------------------------- secrets provider
# `env` reads the values below. `aws` reads Secrets Manager through boto3's
# default credential chain (IRSA in-cluster).
SECRETS_PROVIDER=env

# ----------------------------------------------------------------- database
# MUST MATCH database/.env  (POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD).
# `./scripts/check-env.sh` verifies this.
#
# This service does NOT create tables. Flyway in the middleware owns the schema
# for the whole database, including the ai_* tables mapped here, so the
# middleware must have started at least once before this service is useful.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ai_interview
DB_USERNAME=ai_interview_app
DB_PASSWORD=change-me-locally
DB_SSLMODE=prefer
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=15000

# Only the test suite builds tables (against in-memory SQLite). Never enable
# this against PostgreSQL — it would put two services in charge of DDL.
CREATE_SCHEMA_ON_STARTUP=false

# ----------------------------------------------------------------- service-to-service auth
# MUST MATCH middleware/.env AI_SERVICE_API_KEY.
# The middleware sends this as the X-Internal-Api-Key header. This service is
# never exposed through the Ingress; the key stops another pod in the namespace
# from spending model tokens.
INTERNAL_API_KEY=local-dev-internal-api-key

# ----------------------------------------------------------------- ai provider
# `mock`   deterministic, offline, zero cost — the right default for a session
# `openai` real model, needs OPENAI_API_KEY and costs tokens
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1
OPENAI_TEMPERATURE=0.4

MAX_QUESTIONS_PER_REQUEST=20

# ----------------------------------------------------------------- aws
# Never set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
AWS_REGION=ap-south-1
# Only read when SECRETS_PROVIDER=aws:
# AWS_DATABASE_SECRET_ID=ai-interview/dev/database
# AWS_APPLICATION_SECRET_ID=ai-interview/dev/application
