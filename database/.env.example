# =============================================================================
# PostgreSQL container configuration.
#
#   cp database/.env.example database/.env
#
# Read only by the postgres container (docker-compose.yml -> env_file).
#
# -----------------------------------------------------------------------------
# THREE VALUES HERE ARE MIRRORED IN OTHER SERVICES AND MUST MATCH EXACTLY:
#
#   POSTGRES_DB       ==  middleware/.env DB_NAME      ==  backend/.env DB_NAME
#   POSTGRES_USER     ==  middleware/.env DB_USERNAME  ==  backend/.env DB_USERNAME
#   POSTGRES_PASSWORD ==  middleware/.env DB_PASSWORD  ==  backend/.env DB_PASSWORD
#
# This duplication is the cost of per-service env files. Run
# `./scripts/check-env.sh` after editing any of them — it fails loudly on drift,
# which otherwise shows up as a confusing "password authentication failed" from
# a service that looks correctly configured.
# -----------------------------------------------------------------------------
# =============================================================================

POSTGRES_DB=ai_interview
POSTGRES_USER=ai_interview_app
POSTGRES_PASSWORD=change-me-locally

# Keeps initdb deterministic regardless of the host's locale.
POSTGRES_INITDB_ARGS=--encoding=UTF8 --lc-collate=C --lc-ctype=C

# The image refuses to initialise onto a non-empty mount, and a volume often
# contains lost+found, so the data lives in a subdirectory.
PGDATA=/var/lib/postgresql/data/pgdata
