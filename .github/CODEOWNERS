# =============================================================================
# Code owners.
#
# Combined with a branch protection rule requiring review from code owners, this
# turns "someone should look at the Terraform" into an enforced gate.
#
# Last matching pattern wins, so the specific rules at the bottom override the
# catch-all at the top. Replace the placeholder teams with real ones.
# =============================================================================

# Default owner for anything not matched below.
*                           @your-org/platform-engineering

# ----------------------------------------------------------------- application
/middleware/                @your-org/backend-team
/backend/                   @your-org/ai-team
/frontend/                  @your-org/frontend-team

# ----------------------------------------------------------------- schema
# Migrations are immutable once merged and cannot be rolled back cleanly, so
# they get a second pair of eyes regardless of who wrote them.
/middleware/src/main/resources/db/migration/   @your-org/backend-team @your-org/platform-engineering
/database/                                     @your-org/platform-engineering

# ----------------------------------------------------------------- infrastructure
/helm/                      @your-org/platform-engineering
/terraform/                 @your-org/platform-engineering
/argocd/                    @your-org/platform-engineering
/.github/                   @your-org/platform-engineering
/docker-compose.yml         @your-org/platform-engineering

# ----------------------------------------------------------------- security
# Anything that changes how the platform authenticates, authorises or handles
# credentials requires security review.
/.gitleaks.toml                                              @your-org/security
/middleware/src/main/java/ai/interview/middleware/security/   @your-org/security @your-org/backend-team
/middleware/src/main/java/ai/interview/middleware/config/SecurityConfig.java   @your-org/security
/middleware/src/main/java/ai/interview/middleware/service/secret/              @your-org/security
/backend/app/core/secrets.py                                 @your-org/security
/backend/app/core/security.py                                @your-org/security
/terraform/parked/iam.tf                                     @your-org/security @your-org/platform-engineering
